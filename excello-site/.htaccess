# Cache rules for Apache shared hosting (cPanel, etc.).
# The Node server sets equivalent rules itself; this only applies when the
# static files are served directly by Apache.

<IfModule mod_headers.c>
  # Heavy, content-stable assets — cache hard so refreshes are instant.
  <FilesMatch "\.(webp|avif|jpe?g|png|gif|svg|woff2?|ttf|otf|mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
  # App code and pages — always revalidate so edits/redeploys show immediately.
  <FilesMatch "\.(html|js|css|json)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Route consolidation per 14 October 2026 master guide
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Services sub-paths folded into /services sections
  RewriteRule ^services/homes/?$        /services/#homes       [R=301,L]
  # Apartments and hospitality move under Developments
  RewriteRule ^services/apartments/?$   /developments/         [R=301,L]
  RewriteRule ^services/hospitality/?$  /developments/         [R=301,L]
  # Retired homev2 points to the current home
  RewriteRule ^homev2/?$                /                      [R=301,L]
  # About folds into Team
  RewriteRule ^about(/.*)?$             /team/                 [R=301,L]
</IfModule>
